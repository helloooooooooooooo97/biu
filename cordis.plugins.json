{
  "host": [
    { "id": "http", "package": "@biu/host-http", "togglable": false, "enabled": true },
    { "id": "update", "package": "@biu/host-update", "togglable": false, "enabled": true },
    { "id": "session-store", "package": "@biu/host-session-store", "togglable": false, "enabled": true },
    { "id": "sessions", "package": "@biu/host-sessions", "togglable": false, "enabled": true },
    { "id": "tools", "package": "@biu/host-tools", "togglable": false, "enabled": true },
    { "id": "system-prompt", "package": "@biu/host-system-prompt", "togglable": false, "enabled": true },
    { "id": "llm", "package": "@biu/host-llm", "togglable": false, "enabled": true },
    { "id": "fs", "package": "@biu/host-fs", "togglable": false, "enabled": true },
    { "id": "sandbox", "package": "@biu/host-sandbox", "togglable": false, "enabled": true },
    { "id": "subprocess", "package": "@biu/host-subprocess", "togglable": false, "enabled": true },
    { "id": "shell", "package": "@biu/host-shell", "togglable": false, "enabled": true },
    { "id": "jobs", "package": "@biu/host-jobs", "togglable": false, "enabled": true },
    { "id": "mcp", "package": "@biu/host-mcp", "togglable": false, "enabled": true },
    { "id": "terminal", "package": "@biu/host-terminal", "togglable": false, "enabled": true },
    { "id": "lsp", "package": "@biu/host-lsp", "togglable": false, "enabled": true },
    { "id": "web", "package": "@biu/host-web", "togglable": false, "enabled": true },
    { "id": "context", "package": "@biu/host-context", "togglable": false, "enabled": true },
    { "id": "approvals", "package": "@biu/host-approvals", "togglable": false, "enabled": true },
    { "id": "agent-loop", "package": "@biu/host-agent-loop", "togglable": false, "enabled": true },
    { "id": "agents", "package": "@biu/host-agents", "togglable": false, "enabled": true },
    { "id": "subagents", "package": "@biu/host-subagents", "togglable": false, "enabled": true },
    { "id": "live-sessions", "package": "@biu/host-live-sessions", "togglable": false, "enabled": true },
    { "id": "hub", "package": "@biu/host-hub", "togglable": false, "enabled": true }
  ],
  "web": [
    { "id": "slots", "package": "@biu/web-slots", "togglable": false, "enabled": true },
    { "id": "app-modules", "package": "@biu/web-app-modules", "togglable": false, "enabled": true },
    { "id": "session-view", "package": "@biu/web-session-view", "togglable": false, "enabled": true },
    { "id": "project-view", "package": "@biu/web-project-view", "togglable": false, "enabled": true },
    { "id": "snapshot", "package": "@biu/web-snapshot", "togglable": false, "enabled": true },
    { "id": "react-host", "package": "@biu/web-react-host", "togglable": false, "enabled": true },
    { "id": "shell", "package": "@biu/web-app-shell", "togglable": false, "enabled": true },
    { "id": "plugin-tree", "package": "@biu/web-plugin-tree", "togglable": false, "enabled": true },
    { "id": "event-log", "package": "@biu/web-event-log", "togglable": false, "enabled": true },
    { "id": "routes-panel", "package": "@biu/web-routes-panel", "togglable": false, "enabled": true },
    { "id": "ui-hub", "package": "@biu/web-ui-hub", "togglable": false, "enabled": true }
  ],
  "plugins": [
    {
      "id": "core-pick",
      "name": "Core-Pick",
      "layer": "core",
      "blurb": "界面点选数据句柄（合集/记录）。给 Agent 的是选中结果，不是自己去点 DOM。",
      "package": "@biu/core-pick/host",
      "web": "@biu/core-pick/web",
      "togglable": false,
      "enabled": true
    },
    {
      "id": "core-chat",
      "name": "Core-Chat",
      "layer": "core",
      "blurb": "会话表 /sessions：一行=一个代理（agent）。用户要「再开一个 agent」就是 db_create 一行会话。改元数据 db_update；动作 inspect/progress/status/compact/clear/retrieve 都是针对那一个代理。",
      "package": "@biu/core-chat/host",
      "web": "@biu/core-chat/web",
      "togglable": false,
      "enabled": true
    },
    {
      "id": "logger",
      "name": "事件日志",
      "layer": "capability",
      "blurb": "旁观 internal/dispatch。看实时事件用这个，不要往只读的 /events 表里写。",
      "package": "@biu/cap-logger/host",
      "togglable": true,
      "enabled": true
    },
    {
      "id": "mascot-easter-egg",
      "name": "Mascot 彩蛋",
      "layer": "capability",
      "blurb": "提供 mascot_dance 工具，给形象跳舞。不是会话形象配置（那是 /sessions 的 mascot 列）。",
      "package": "@biu/cap-mascot-easter-egg/host",
      "togglable": true,
      "enabled": true
    },
    {
      "id": "core-file-system",
      "name": "Core-File System",
      "layer": "core",
      "blurb": "登记各表并提供 db_list/read/update/create/delete/action/stat/content。先 db_list / 读每张表的 view.blurb（含该表全部动作），再对 /<表> 动手。",
      "package": "@biu/core-file-system/host",
      "web": "@biu/core-file-system/web",
      "togglable": false,
      "enabled": true
    },
    {
      "id": "core-editor",
      "name": "Core-Editor",
      "layer": "core",
      "blurb": "记录正文 Markdown 编辑器，不自己落盘；各表经 File System 的 content 字段持久化。会话对话不用它。",
      "package": "@biu/core-editor/host",
      "web": "@biu/core-editor/web",
      "togglable": false,
      "enabled": true
    },
    {
      "id": "core-plugin-system",
      "name": "Core-Plugin System",
      "layer": "core",
      "blurb": "插件表 /plugins，不是代理。代理在 /sessions。本表动作 create/sandbox/pack/start/stop/uninstall 只操作插件代码。",
      "package": "@biu/core-plugin-system/host",
      "web": "@biu/core-plugin-system/web",
      "togglable": false,
      "enabled": true
    },
    {
      "id": "core-task-system",
      "name": "Core-Task System",
      "layer": "core",
      "blurb": "任务表 /tasks。让另一个代理做事：assignee 写成它的会话 id，再 db_action deliver。执行中的代理用 report 汇报。",
      "package": "@biu/core-task-system/host",
      "web": "@biu/core-task-system/web",
      "togglable": false,
      "enabled": true
    },
    {
      "id": "skills",
      "name": "技能",
      "layer": "capability",
      "blurb": "技能仓库 /skills：标准目录导入为 /pages Page 树，仓库只登记发现信息。正文不进 system prompt，Agent 相关时才 skill_read 读取入口 Page。",
      "package": "@biu/host-skills",
      "web": "@biu/host-skills/web",
      "togglable": true,
      "enabled": true
    },
    {
      "id": "core-page",
      "name": "Core-Page",
      "layer": "core",
      "blurb": "页面表 /pages。属性 db_update，正文 db_content（notes）。图和附件在仓库 .biu/assets。",
      "package": "@biu/core-page/host",
      "web": "@biu/core-page/web",
      "togglable": false,
      "enabled": true
    }
  ]
}
