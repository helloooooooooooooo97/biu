{
  "name": "biu",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Biu",
  "homepage": "https://github.com/helloooooooooooooo97/biu",
  "repository": {
    "type": "git",
    "url": "https://github.com/helloooooooooooooo97/biu.git"
  },
  "description": "Biu Agent OS：一切即插件，多 Agent 不靠群聊，而是通过任务看板协作。基于 Cordis，事件流驱动，一切可溯源。",
  "type": "module",
  "main": "electron/out/main.js",
  "workspaces": [
    "packages/*",
    "electron/host-runtime"
  ],
  "scripts": {
    "postinstall": "node scripts/link-cordis-plugins.mjs",
    "predev": "node scripts/link-cordis-plugins.mjs",
    "prestart": "node scripts/link-cordis-plugins.mjs",
    "dev": "concurrently -k \"npm:dev:host\" \"npm:dev:web\"",
    "dev:host": "SHARE_PORT=3142 SHARE_HOST=0.0.0.0 SHARE_PROXY_UI=http://127.0.0.1:5173 tsx host/index.ts",
    "dev:host:nowatch": "SHARE_PORT=3142 SHARE_HOST=0.0.0.0 SHARE_PROXY_UI=http://127.0.0.1:5173 tsx host/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "SHARE_PORT=3142 SHARE_HOST=0.0.0.0 tsx host/index.ts",
    "test": "vitest run",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:wait": "node scripts/electron-launch.mjs",
    "electron:build": "npm run build && env BIU_ELECTRON_DEV=0 node scripts/electron-launch.mjs",
    "electron:pack": "npm run build && node scripts/electron-pack.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.18.1",
    "@heroicons/react": "^2.2.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/extension-bubble-menu": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-heading": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-mathematics": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@xyflow/react": "^12.11.3",
    "antd": "^6.6.1",
    "cordis": "4.0.0-rc.8",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "marked": "^18.0.10",
    "marked-highlight": "^2.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "ws": "^8.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  }
}
